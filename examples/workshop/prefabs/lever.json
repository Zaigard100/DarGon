{
  "$schema": "../../../assets/data/prefab.schema.json",
  "id": "lever",
  "description": "Рычаг на стене: «использовать» с соседней клетки — выполняется onUse.",
  "placement": "wall",
  "events": ["use"],
  "params": {
    "state": { "type": "int", "default": 0, "min": 0, "max": 1, "description": "0 — выключен, 1 — включён (картинка)." }
  },
  "components": {
    "SpriteRef": { "region": "lever", "frame": "$state" },
    "Layer": { "z": "over" },
    "Interactable": { "reach": "adjacent" },
    "ScriptHandlers": {}
  }
}
