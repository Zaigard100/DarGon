// Стены двигает setTile(): два набора проходов меняются местами.
// lib/events знает, где герой (px, py), — туда стена не ставится.
use "lib/events"

gapsA10 = [[4, 1], [8, 5], [12, 1]]
gapsB10 = [[4, 5], [8, 1], [12, 5]]
phase10 = 0
startAt(1, 3)

def tile10(pt, kind) {
    if kind == "floor" || px != pt[0] || py != pt[1] {
        setTile(pt[0], pt[1], kind)
    }
}

def apply10() {
    for pt in gapsA10 {
        if phase10 == 0 {
            tile10(pt, "floor")
        } else {
            tile10(pt, "wall")
        }
    }
    for pt in gapsB10 {
        if phase10 == 0 {
            tile10(pt, "wall")
        } else {
            tile10(pt, "floor")
        }
    }
}

apply10()
every(1.5, def() {
    phase10 = 1 - phase10
    apply10()
})
