// Случайный лабиринт «поиском с возвратом» прямо на клетках карты.
// maze(x, y, w, h): w и h нечётные; комнаты — клетки с чётным смещением.
use "lib/util"

def maze(x0, y0, w, h) {
    fill(x0, y0, x0 + w - 1, y0 + h - 1, "wall")
    cw = int((w + 1) / 2)
    ch = int((h + 1) / 2)
    seen = array(ch, cw)
    stack = [[0, 0]]
    seen[0][0] = 1
    setTile(x0, y0, "floor")
    while len(stack) > 0 {
        top = stack[len(stack) - 1]
        options = []
        for d in [[1, 0], [-1, 0], [0, 1], [0, -1]] {
            nx = top[0] + d[0]
            ny = top[1] + d[1]
            if nx >= 0 && ny >= 0 && nx < cw && ny < ch && seen[ny][nx] == 0 {
                push(options, [nx, ny])
            }
        }
        if len(options) == 0 {
            pop(stack)
        } else {
            pick = options[rand(len(options))]
            seen[pick[1]][pick[0]] = 1
            // Пробить стену между клетками и саму клетку.
            setTile(x0 + top[0] + pick[0], y0 + top[1] + pick[1], "floor")
            setTile(x0 + pick[0] * 2, y0 + pick[1] * 2, "floor")
            push(stack, pick)
        }
    }
}
