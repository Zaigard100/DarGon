// Сапёр на скриптах. Мины — скрытые ловушки, их раскладывает скрипт (moveTo)
// так, чтобы безопасный путь был. Числа — запас картинок-цифр в закрытой клетке:
// открытая клетка берёт цифру из запаса и ставит её на себя.
use "lib/events"
use "lib/util"

fx19 = 2
fy19 = 1
fw19 = 9
fh19 = 7
mineCount19 = 12
pool19 = [
    ["d0_0", "d0_1", "d0_2", "d0_3", "d0_4", "d0_5", "d0_6", "d0_7", "d0_8", "d0_9", "d0_10", "d0_11", "d0_12", "d0_13", "d0_14", "d0_15", "d0_16", "d0_17", "d0_18", "d0_19", "d0_20", "d0_21", "d0_22", "d0_23", "d0_24", "d0_25", "d0_26", "d0_27", "d0_28", "d0_29", "d0_30", "d0_31", "d0_32", "d0_33", "d0_34", "d0_35", "d0_36", "d0_37", "d0_38", "d0_39"],
    ["d1_0", "d1_1", "d1_2", "d1_3", "d1_4", "d1_5", "d1_6", "d1_7", "d1_8", "d1_9", "d1_10", "d1_11", "d1_12", "d1_13", "d1_14", "d1_15", "d1_16", "d1_17", "d1_18", "d1_19", "d1_20", "d1_21"],
    ["d2_0", "d2_1", "d2_2", "d2_3", "d2_4", "d2_5", "d2_6", "d2_7", "d2_8", "d2_9", "d2_10", "d2_11", "d2_12", "d2_13"],
    ["d3_0", "d3_1", "d3_2", "d3_3", "d3_4", "d3_5", "d3_6", "d3_7"],
    ["d4_0", "d4_1", "d4_2", "d4_3"],
    ["d5_0", "d5_1"],
    ["d6_0", "d6_1"],
    ["d7_0"],
    ["d8_0"]
]
used19 = array(9)
mine19 = []
shown19 = []
stepped19 = false
done19 = false

def inField19(cx, cy) {
    return cx >= 0 && cy >= 0 && cx < fw19 && cy < fh19
}

// Есть ли путь от левого края поля до правого в обход мин.
def passable19() {
    seen = array(fh19, fw19)
    queue = []
    for cy = 0, cy < fh19, cy += 1 {
        if mine19[cy][0] == 0 {
            push(queue, [0, cy])
            seen[cy][0] = 1
        }
    }
    head = 0
    while head < len(queue) {
        c = queue[head]
        head += 1
        if c[0] == fw19 - 1 {
            return true
        }
        for d in [[1, 0], [-1, 0], [0, 1], [0, -1]] {
            nx = c[0] + d[0]
            ny = c[1] + d[1]
            if inField19(nx, ny) && seen[ny][nx] == 0 && mine19[ny][nx] == 0 {
                seen[ny][nx] = 1
                push(queue, [nx, ny])
            }
        }
    }
    return false
}

def layMines19() {
    ok = false
    while !ok {
        mine19 = array(fh19, fw19)
        placed = 0
        while placed < mineCount19 {
            cx = rand(fw19)
            cy = rand(fh19)
            // У входа (клетка 0, 3) и рядом с ней мин нет — первый шаг безопасен.
            nearStart = cx <= 1 && cy >= 2 && cy <= 4
            if mine19[cy][cx] == 0 && !nearStart {
                mine19[cy][cx] = 1
                placed += 1
            }
        }
        ok = passable19()
    }
    k = 0
    for cy = 0, cy < fh19, cy += 1 {
        for cx = 0, cx < fw19, cx += 1 {
            if mine19[cy][cx] == 1 {
                entity("m" + k).moveTo(fx19 + cx, fy19 + cy)
                k += 1
            }
        }
    }
}

def count19(cx, cy) {
    n = 0
    for dy = -1, dy <= 1, dy += 1 {
        for dx = -1, dx <= 1, dx += 1 {
            if inField19(cx + dx, cy + dy) && mine19[cy + dy][cx + dx] == 1 {
                n += 1
            }
        }
    }
    return n
}

def show19(cx, cy, n) {
    if used19[n] < len(pool19[n]) {
        digit = entity(pool19[n][used19[n]])
        used19[n] += 1
        digit.moveTo(fx19 + cx, fy19 + cy)
        digit.enable()
    }
}

// Открыть клетку; вокруг нуля открываются и соседи (как в настоящем сапёре).
def reveal19(sx, sy) {
    stack = [[sx, sy]]
    while len(stack) > 0 {
        c = pop(stack)
        cx = c[0]
        cy = c[1]
        if shown19[cy][cx] == 0 && mine19[cy][cx] == 0 {
            shown19[cy][cx] = 1
            n = count19(cx, cy)
            show19(cx, cy, n)
            if n == 0 {
                for dy = -1, dy <= 1, dy += 1 {
                    for dx = -1, dx <= 1, dx += 1 {
                        if inField19(cx + dx, cy + dy) {
                            push(stack, [cx + dx, cy + dy])
                        }
                    }
                }
            }
        }
    }
}

// Мины раскладываются в хуке init — когда все объекты уровня уже на месте.
shown19 = array(fh19, fw19)
onInit(def() {
    layMines19()
    reveal19(0, 3)
})

onStep(def(x, y) {
    cx = x - fx19
    cy = y - fy19
    if inField19(cx, cy) {
        if mine19[cy][cx] == 1 {
            stepped19 = true
        } else {
            reveal19(cx, cy)
        }
    }
    if x == 11 && y == 4 && !stepped19 && !done19 {
        done19 = true
        achieve("sapper")
    }
})
