// Тёмный уровень: светлячок (лампа) летает по кратчайшему пути к выходу.
// Путь посчитан заранее и записан в скрипт — patrol() водит лампу туда и обратно.
use "lib/patrol"

route08 = [[1, 1], [2, 1], [3, 1], [3, 2], [3, 3], [2, 3], [1, 3], [1, 4], [1, 5], [2, 5], [3, 5], [4, 5], [5, 5], [6, 5], [7, 5], [8, 5], [9, 5], [10, 5], [11, 5], [11, 4], [11, 3], [12, 3], [13, 3], [13, 4], [13, 5], [13, 6], [13, 7], [13, 8], [13, 9]]
patrol("firefly", route08, 0.32, 0)
