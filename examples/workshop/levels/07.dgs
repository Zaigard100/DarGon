// Дирижёр: каждые 0.8 с новый такт. Колонка c гаснет на такте c % 3 —
// «окно» бежит слева направо, и за ним можно пройти.
use "lib/util"

cols07 = 4
beat07 = 0
phase07 = 0

def show07() {
    for c = 0, c < cols07, c += 1 {
        safe = c % 3 == beat07
        entity("f" + c).enabled = !safe
        entity("k7_" + c).enabled = safe
    }
}

show07()
every(0.8, def() {
    beat07 = (beat07 + 1) % 3
    phase07 = 0
    show07()
})

// Время с начала такта — хук loop(dt).
def loop(dt) {
    phase07 += dt
}
