// Скрипт уровня 18 (переведён из функций кнопок DarGon3).

def but1Pressed() {
    setTile(0, 7, "wall")
    setTile(1, 7, "wall")
    setTile(0, 5, "floor")
    setTile(1, 5, "wall")
    setTile(1, 4, "wall")
    setTile(1, 3, "wall")
    setTile(2, 3, "floor")
    setTile(3, 2, "wall")
    setTile(3, 1, "wall")
    setTile(4, 3, "floor")
    setTile(3, 5, "wall")
    setTile(3, 4, "wall")
    entity("but1").disable()
    entity("but2").enable()
}

