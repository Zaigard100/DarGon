{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "param.schema.json",
  "title": "DarGon: описание параметра",
  "description": "Параметр префаба или поле предмета. Без default — обязательный; default: null — необязательный.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "type": {
      "enum": ["int", "number", "bool", "string", "text", "direction", "direction8", "point", "color", "level", "entity", "item", "items", "offers", "damage"]
    },
    "default": {},
    "min": { "type": "number" },
    "max": { "type": "number" },
    "values": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "description": { "type": "string" }
  }
}
