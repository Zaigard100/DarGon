{
  "$schema": "../prefab.schema.json",
  "id": "crossbow",
  "description": "Арбалет: каждые period секунд стреляет стрелой в направлении dir.",
  "placement": "wall",
  "params": {
    "dir": {
      "type": "direction8"
    },
    "period": {
      "type": "number",
      "default": 4.0,
      "min": 0.1
    }
  },
  "components": {
    "SpriteRef": {
      "region": "crossbow",
      "frame": 1,
      "angle": 180
    },
    "Layer": {
      "z": "over"
    },
    "Facing": {
      "dir": "$dir"
    },
    "Emitter": {
      "kind": "arrow",
      "dir": "$dir",
      "period": "$period"
    }
  }
}
