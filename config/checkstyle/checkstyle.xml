<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Минимальный набор правил: форматирование делает Spotless, здесь — только то, что он не ловит. -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <module name="SuppressWarningsFilter"/>
    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>
        <!-- Логи только через Log, никаких System.out / printStackTrace. -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\.print"/>
            <property name="message" value="Используйте логгер вместо System.out/err."/>
            <property name="ignoreComments" value="true"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="\.printStackTrace\(\)"/>
            <property name="message" value="Используйте логгер вместо printStackTrace()."/>
            <property name="ignoreComments" value="true"/>
        </module>
        <!-- Строки сравниваются только через equals. -->
        <module name="StringLiteralEquality"/>
        <module name="EqualsHashCode"/>
        <module name="EmptyCatchBlock"/>
        <module name="FallThrough"/>
        <module name="MissingSwitchDefault"/>
        <module name="ModifiedControlVariable"/>
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="IllegalImport">
            <property name="illegalPkgs" value="sun, jdk.internal, jdk.nashorn"/>
        </module>
        <!-- Имена типов — только латиница (в старой версии был класс ButtonС с кириллической «С»). -->
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="ConstantName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
    </module>
</module>
